diff --git a/09_PatchDiff/labirinth.c b/09_PatchDiff/labirinth.c
index 277df0c..3e82714 100644
--- a/09_PatchDiff/labirinth.c
+++ b/09_PatchDiff/labirinth.c
@@ -27,7 +27,9 @@ int new_group(int *labirinth, int N) {
 
 int main(int argc, char *argv[]) {
 	srand(time(NULL));
-	int N = atoi(argv[1]);
+	char passage = argv[1][0];
+	char wall = argv[1][1];
+	int N = atoi(argv[2]);
 	int *labirinth = (int *) malloc(sizeof(int) * 2 * N);
 	int *reachibility = (int *) malloc(sizeof(int) * N * N);
 	short *walls = (short *) malloc(sizeof(int) * N);
@@ -37,10 +39,10 @@ int main(int argc, char *argv[]) {
 	}
 	
 	// First row-wall
-	printing[0] = '#';
+	printing[0] = wall;
 	for (int i = 0; i < N; ++i) {
-        printing[2 * i + 1] = '#';
-        printing[2 * (i + 1)] = '#';
+        printing[2 * i + 1] = wall;
+        printing[2 * (i + 1)] = wall;
     }
 	
 	for (int iter = 0; iter < N; ++iter) {
@@ -52,24 +54,24 @@ int main(int argc, char *argv[]) {
 		
 		// Merge elements in the row
         int cur_pos = (2 * iter + 1) * (2 * N + 1);
-		printing[cur_pos] = '#';
+		printing[cur_pos] = wall;
 		for (int i = 0; i < N - 1; ++i) {
-			printing[cur_pos + (2 * i) + 1] = '.';
